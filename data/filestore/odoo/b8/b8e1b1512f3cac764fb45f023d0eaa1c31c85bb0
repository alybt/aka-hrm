            this.style = style;
            this.sheetId = sheetId;
            this.getRangeString = getRangeString;
            let rangeIndex = 0;
            const tokens = compiledFormula.tokens.map((token) => {
                if (token.type === "REFERENCE") {
                    const index = rangeIndex++;
