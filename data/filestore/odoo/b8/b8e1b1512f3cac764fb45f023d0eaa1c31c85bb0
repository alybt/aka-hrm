                            ],
                            "readonly fields value should be sent for onchanges"
                        );
                    }
                }
                if (args.method === "web_save") {
                    assert.deepEqual(
                        args.args[1],
                        {
                            p: [[0, args.args[1].p[0][1], { display_name: "readonly" }]],
