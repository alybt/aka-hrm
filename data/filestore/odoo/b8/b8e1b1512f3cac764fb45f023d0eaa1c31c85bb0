                                name: `odoo.exceptions.${"UserError"}`,
                                debug: "traceback",
                                arguments: [],
                                context: {},
                                message: "error",
                            },
                        });
                    } else {
                        assert.step("resequence onChange ok");
                    }
                }
            },
        };

        serverData.views = {
