        serviceRegistry.add("action", mockedActionService, { force: true });

        serverData.models.partner.records.push(
            { id: 10, int_field: 1 },
            { id: 11, int_field: 2 },
            { id: 12, int_field: 3 },
            { id: 13 }
        );
        serverData.models.partner.records[0].p = [10, 11, 12, 13];

        await makeView({
            type: "form",
            resModel: "partner",
            serverData,
            arch: `
                    <form>
