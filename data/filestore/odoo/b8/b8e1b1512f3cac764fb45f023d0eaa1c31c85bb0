    QUnit.test(
        "resequence all when create(ing) a new record + partial resequencing",
        async (assert) => {
            let resequenceOffset;
            await makeView({
                type: "kanban",
                resModel: "partner",
                serverData,
                arch: /* xml */ `
                <kanban>
                    <field name="product_id"/>
                    <templates>
