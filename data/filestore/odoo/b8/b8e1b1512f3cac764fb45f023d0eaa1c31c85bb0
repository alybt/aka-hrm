    QUnit.test("do not call getValue if already cached", async (assert) => {
        const cache = new Cache((key) => {
            assert.step(key);
            return key.toUpperCase();
        });

        assert.strictEqual(cache.read("a"), "A");
        assert.strictEqual(cache.read("b"), "B");
