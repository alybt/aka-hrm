<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="hr_leave_view_form_overtime" model="ir.ui.view">
        <field name="name">hr.leave.form.overtime</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Display employee's total overtime balance -->
            <xpath expr="//group[@name='duration']" position="inside">
                <field name="employee_total_overtime"
                       string="Available Overtime Hours"
                       widget="float_time"
                       optional="show"/>
            </xpath>

            <!-- Show overtime deductible status -->
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="overtime_deductible"
                       string="Uses Overtime"
                       invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="hr_leave_view_tree_overtime" model="ir.ui.view">
        <field name="name">hr.leave.tree.overtime</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="employee_total_overtime"
                       string="Overtime Balance"
                       widget="float_time"
                       optional="show"/>
            </field>
        </field>
    </record>
</odoo>