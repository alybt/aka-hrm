<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Import History -->
    <record id="view_attendance_import_tree" model="ir.ui.view">
        <field name="name">attendance.import.tree</field>
        <field name="model">attendance.import</field>
        <field name="arch" type="xml">
            <tree>
                <field name="import_date"/>
                <field name="file_name"/>
                <field name="device_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'processing'"/>
                <field name="total_records"/>
                <field name="success_records"/>
                <field name="failed_records"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Import -->
    <record id="view_attendance_import_form" model="ir.ui.view">
        <field name="name">attendance.import.form</field>
        <field name="model">attendance.import</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="import_date"/>
                            <field name="device_id" 
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="file_name"/>
                        </group>
                    </group>
                    <group string="File" 
                           attrs="{'invisible': [('status', 'not in', ['draft'])]}">
                        <field name="file_data" 
                               filename="file_name" 
                               required="1"
                               widget="binary"/>
                    </group>
                    <group string="Import Results" 
                           attrs="{'invisible': [('status', 'in', ['draft', 'processing'])]}">
                        <group>
                            <field name="total_records"/>
                            <field name="success_records"/>
                            <field name="failed_records"/>
                        </group>
                    </group>
                    <group string="Error Log" 
                           attrs="{'invisible': [('failed_records', '=', 0)]}">
                        <field name="error_log"/>
                    </group>
                    <footer>
                        <button name="action_process_import" type="object" 
                                string="Import" class="btn-primary"
                                attrs="{'invisible': [('status', 'not in', ['draft'])]}"/>
                        <button string="Cancel" class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_attendance_import" model="ir.actions.act_window">
        <field name="name">Attendance Import History</field>
        <field name="res_model">attendance.import</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>