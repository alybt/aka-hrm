<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sync_attendance_logs" model="ir.cron">
            <field name="name">Sync Biometric Attendance Logs</field>
            <field name="model_id" ref="model_biometric_attendance_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_pending_logs()</field>
            <field name="interval_number">5</field>
