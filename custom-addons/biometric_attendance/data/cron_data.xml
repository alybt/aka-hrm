<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sync_biometric_attendance" model="ir.cron">
            <field name="name">Sync Biometric Attendance Logs</field>
            <field name="model_id" ref="model_biometric_attendance_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_pending_logs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_sync_device_attendance" model="ir.cron">
            <field name="name">Auto Sync Device Attendance</field>
            <field name="model_id" ref="model_biometric_device"/>
            <field name="state">code</field>
            <field name="code">self.search([('auto_sync', '=', True), ('device_status', '=', 'connected')]).action_sync_attendance()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>