<odoo>
    <record id="view_public_holiday_line_form_inherit" model="ir.ui.view">
        <field name="name">hr.holidays.public.line.form.inherit.type</field>
        <field name="model">hr.holidays.public.line</field>
        <field name="inherit_id" ref="hr_holidays_public.view_public_holiday_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="holiday_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_public_holiday_line_tree_inherit" model="ir.ui.view">
        <field name="name">hr.holidays.public.line.tree.inherit.type</field>
        <field name="model">hr.holidays.public.line</field>
        <field name="inherit_id" ref="hr_holidays_public.view_public_holiday_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="holiday_type"/>
            </xpath>
        </field>
    </record>
</odoo>