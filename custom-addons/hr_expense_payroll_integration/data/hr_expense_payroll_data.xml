<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Create salary rule category for expense reimbursements -->
        <record id="hr_salary_rule_category_expense_reimbursement" model="hr.salary.rule.category">
            <field name="name">Expense Reimbursement</field>
            <field name="code">EXP_REIMB_CAT</field>
        </record>

        <!-- Create salary rule for expense reimbursements -->
        <record id="hr_salary_rule_expense_reimbursement" model="hr.salary.rule">
            <field name="name">Expense Reimbursement</field>
            <field name="code">EXP_REIMB</field>
            <field name="category_id" ref="hr_salary_rule_category_expense_reimbursement"/>
            <field name="sequence">105</field>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0</field>
            <field name="quantity">1</field>
            <field name="appears_on_payslip">True</field>
            <field name="active">True</field>
        </record>

        <!-- Create payroll structure for expense reimbursements (if not exists) -->
        <record id="hr_payroll_structure_expense_reimbursement" model="hr.payroll.structure">
            <field name="name">Employee Payroll with Expense Reimbursement</field>
            <field name="code">EXP_REIMB_STRUCT</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="rule_ids" eval="[(6, 0, [
                ref('payroll.hr_salary_rule_hra'),
                ref('payroll.hr_salary_rule_ca'),
                ref('hr_salary_rule_expense_reimbursement'),
                ref('payroll.hr_salary_rule_basic'),
                ref('payroll.hr_salary_rule_professional_tax'),
                ref('payroll.hr_salary_rule_provident_fund'),
                ref('payroll.hr_salary_rule_income_tax')
            ])]"/>
        </record>

    </data>
</odoo>
