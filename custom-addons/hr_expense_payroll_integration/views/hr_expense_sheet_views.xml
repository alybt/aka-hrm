<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_hr_expense_sheet_form_payroll" model="ir.ui.view">
            <field name="name">hr.expense.sheet.form.payroll</field>
            <field name="model">hr.expense.sheet</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_sheet_form_view"/>
            <field name="arch" type="xml">
                <!-- Add payroll fields to the form -->
                <xpath expr="//field[@name='payment_mode']" position="after">
                    <field name="include_in_payroll" 
                           attrs="{'invisible': [('payment_mode', '!=', 'own_account')], 'readonly': [('state', 'not in', ['draft', 'submit'])]}"/>
                    <field name="payroll_paid" attrs="{'invisible': [('include_in_payroll', '=', False)]}"/>
                    <field name="payroll_paid_date" attrs="{'invisible': [('payroll_paid', '=', False)]}"/>
                </xpath>

                <!-- Add payroll button to the form -->
                <xpath expr="//button[@name='action_register_payment']" position="after">
                    <button name="action_mark_payroll_paid" 
                            type="object" 
                            string="Mark as Paid via Payroll"
                            attrs="{'invisible': ['|', ('include_in_payroll', '=', False), ('payroll_paid', '=', True), ('state', '!=', 'approve')]}"
                            class="btn-primary"/>
                </xpath>

                <!-- Modify Register Payment button visibility -->
                <xpath expr="//button[@name='action_register_payment']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'post'), ('payment_state', 'in', ('paid', 'in_payment')), ('include_in_payroll', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

        <!-- List View -->
        <record id="view_hr_expense_sheet_tree_payroll" model="ir.ui.view">
            <field name="name">hr.expense.sheet.tree.payroll</field>
            <field name="model">hr.expense.sheet</field>
            <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_state']" position="before">
                    <field name="include_in_payroll" optional="show"/>
                    <field name="payroll_paid" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hr_expense_sheet_filter_payroll" model="ir.ui.view">
            <field name="name">hr.expense.sheet.filter.payroll</field>
            <field name="model">hr.expense.sheet</field>
            <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_expenses']" position="after">
                    <separator/>
                    <filter string="Include in Payroll" name="include_in_payroll" domain="[('include_in_payroll', '=', True)]"/>
                    <filter string="Paid via Payroll" name="payroll_paid" domain="[('payroll_paid', '=', True)]"/>
                    <filter string="Pending Payroll Payment" name="pending_payroll" domain="[('include_in_payroll', '=', True), ('payroll_paid', '=', False), ('state', '=', 'approve')]"/>
                </xpath>

                <xpath expr="//group" position="inside">
                    <filter string="Payroll Status" name="group_payroll" context="{'group_by': 'include_in_payroll'}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
