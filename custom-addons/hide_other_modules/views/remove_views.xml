<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!--Disable Root Discuss-->
        <record id="mail.menu_root_discuss" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <!-- (Optional) Disable Discuss client action
        <record id="mail.action_discuss" model="ir.actions.client">
            <field name="active" eval="False"/>
        </record> -->

        <!-- Removing the Calendar View -->
        <record id="calendar.mail_menu_calendar" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <!-- Hide the "Calendar" submenu item -->
        <record id="calendar.menu_calendar_configuration" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <!-- Invoicing -->
        <record id="account.menu_finance" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <!-- (Optional) Disable Discuss client action
        <record id="mail.action_discuss" model="ir.actions.client">
            <field name="active" eval="False"/>
        </record> -->

        <!-- Dashboard -->
        <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

</odoo>