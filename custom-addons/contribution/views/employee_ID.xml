<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_ph_government" model="ir.ui.view">
        <field name="name">hr.employee.form.ph.government.ids</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Philippine IDs" name="ph_government_ids_page">
                    <group string="Government ID Numbers" col="2">
                        <field name="x_employee_is_active"
                            widget="boolean"
                            string="Active Contribution Status"/>

                        <field name="x_employee_tin_number"
                            placeholder="123-456-789-000"
                            help="Format: XXX-XXX-XXX-XXX (12 digits)"/>
                        <field name="x_employee_sss_number"
                            placeholder="34-1234567-8"
                            help="Format: XX-XXXXXXX-X (10 digits)"/>
                        <field name="x_employee_philhealth_number"
                            placeholder="12-012345678-9"
                            help="Format: XX-XXXXXXXXX-X (12 digits)"/>
                        <field name="x_employee_pagibig_number"
                            placeholder="1212-3456-7890"
                            help="Format: XXXX-XXXX-XXXX (12 digits)"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>