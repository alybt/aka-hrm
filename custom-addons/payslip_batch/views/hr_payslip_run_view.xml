<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Payslip Run Form View -->
    <record id="hr_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.batch.actions</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <!-- Add batch action buttons to the header -->
            <xpath expr="//header" position="inside">
                <button name="action_batch_compute" type="object"
                        string="Compute All"
                        class="btn-primary"
                        groups="payroll.group_payroll_user"
                        confirm="This will compute all draft/verify payslips in this batch. Continue?"/>

                <button name="action_batch_confirm" type="object"
                        string="Confirm All"
                        groups="payroll.group_payroll_user"
                        confirm="This will confirm all draft payslips in this batch. Continue?"/>

                <button name="action_batch_cancel" type="object"
                        string="Cancel All"
                        groups="payroll.group_payroll_manager"
                        confirm="This will cancel all eligible payslips in this batch. Continue?"/>

                <button name="action_batch_set_to_draft" type="object"
                        string="Set to Draft All"
                        groups="payroll.group_payroll_manager"
                        confirm="This will set all cancelled payslips to draft. Continue?"/>

                <button name="action_batch_refetch" type="object"
                        string="Refetch All Data"
                        groups="payroll.group_payroll_user"
                        confirm="This will refresh data for all draft payslips. Continue?"/>
            </xpath>

