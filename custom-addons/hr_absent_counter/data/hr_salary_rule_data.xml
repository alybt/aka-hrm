<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Salary rule for absence deduction -->
        <record id="hr_salary_rule_absence_deduction" model="hr.salary.rule">
            <field name="name">Absence Deduction</field>
            <field name="code">ABSENCE_DED</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="sequence">100</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = payslip.get_absence_deduction_amount(contract.get_daily_rate()) if contract.deduct_absences else 0.0</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.deduct_absences and payslip.total_absence_days > 0</field>
        </record>

        <!-- Salary rule for attendance bonus (perfect attendance) -->
        <record id="hr_salary_rule_attendance_bonus" model="hr.salary.rule">
            <field name="name">Perfect Attendance Bonus</field>
            <field name="code">ATT_BONUS</field>
            <field name="category_id" ref="hr_payroll.ALW"/>
            <field name="sequence">50</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = 1000.0 if payslip.total_absence_days == 0 else 0.0</field>
            <field name="condition_select">python</field>
            <field name="condition_python">result = payslip.total_absence_days == 0</field>
        </record>
    </data>
</odoo>