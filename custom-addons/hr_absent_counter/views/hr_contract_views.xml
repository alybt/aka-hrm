<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add absence deduction settings to contract -->
    <record id="view_contract_absence_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.absence.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_information']" position="inside">
                <group string="Absence Deduction Settings">
                    <field name="deduct_absences"/>
                    <field name="working_days_per_month" attrs="{'invisible': [('deduct_absences', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>