<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_batch_summary_wizard_form" model="ir.ui.view">
        <field name="name">payslip.batch.summary.wizard.form</field>
        <field name="model">payslip.batch.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Batch Summary Report">
                <sheet>
                    <group>
                        <field name="is_admin" invisible="1"/>
                        <field name="batch_id"/>
                        <field name="preparer_id" options="{'no_create': True}"/>
                        <field name="approver_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary" confirm="Are you sure you wanted to print the batch summary report and prepared by this person and approved by this person?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payslip_batch_summary_wizard" model="ir.actions.act_window">
        <field name="name">Batch Summary Report Wizard</field>
        <field name="res_model">payslip.batch.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
