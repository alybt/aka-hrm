<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─────────────────────────────────────────────────────────────
            FORM VIEW – Public Holiday form
            Inherits: resource_calendar_leaves_form_view  (hr_holidays)
    ───────────────────────────────────────────────────────────────── -->
    <record id="resource_calendar_leaves_form_view_holiday_type" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.form.holiday.type</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_form_view"/>
        <field name="arch" type="xml">

            <!-- Insert Holiday Type right after the Name field -->
            <field name="name" position="after">
                <field
                    name="holiday_type"
                    widget="badge"
                    decoration-success="holiday_type == 'regular'"
                    decoration-warning="holiday_type == 'special_non_working'"
                    decoration-info="holiday_type == 'special_working'"
                    decoration-secondary="holiday_type == 'local'"
                    string="Holiday Type"
                    required="1"
                />
            </field>

        </field>
    </record>


    <!-- ─────────────────────────────────────────────────────────────
            LIST (TREE) VIEW – Public Holidays list
            Inherits: resource_calendar_leaves_list_view  (hr_holidays)
    ───────────────────────────────────────────────────────────────── -->
    <record id="resource_calendar_leaves_list_view_holiday_type" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.holiday.type</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_list_view"/>
        <field name="arch" type="xml">

            <!-- Insert Holiday Type column after the Name column -->
            <field name="name" position="after">
                <field
                    name="holiday_type"
                    widget="badge"
                    decoration-success="holiday_type == 'regular'"
                    decoration-warning="holiday_type == 'special_non_working'"
                    decoration-info="holiday_type == 'special_working'"
                    decoration-secondary="holiday_type == 'local'"
                    string="Holiday Type"
                    optional="show"
                />
            </field>

        </field>
    </record>


    <!-- ─────────────────────────────────────────────────────────────
            SEARCH VIEW – add Holiday Type filter & group-by
            Inherits: resource_calendar_leaves_search_view (hr_holidays)
    ───────────────────────────────────────────────────────────────── -->
    <record id="resource_calendar_leaves_search_view_holiday_type" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.search.holiday.type</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_search_view"/>
        <field name="arch" type="xml">

            <!-- Search by holiday type -->
            <field name="name" position="after">
                <field name="holiday_type" string="Holiday Type"/>
            </field>

            <!-- Quick filters -->
            <filter name="filter_work_info" position="before">
                <separator/>
                <filter
                    name="filter_regular"
                    string="Regular Holidays"
                    domain="[('holiday_type','=','regular')]"
                />
                <filter
                    name="filter_special_non_working"
                    string="Special Non-Working Days"
                    domain="[('holiday_type','=','special_non_working')]"
                />
                <filter
                    name="filter_special_working"
                    string="Special Working Days"
                    domain="[('holiday_type','=','special_working')]"
                />
                <filter
                    name="filter_local"
                    string="Local Holidays"
                    domain="[('holiday_type','=','local')]"
                />
                <separator/>
            </filter>

            <!-- Group By Holiday Type -->
            <group expand="0" string="Group By">
                <filter
                    name="group_by_holiday_type"
                    string="Holiday Type"
                    context="{'group_by': 'holiday_type'}"
                />
            </group>

        </field>
    </record>

</odoo>
