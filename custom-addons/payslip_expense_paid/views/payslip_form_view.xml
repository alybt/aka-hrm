<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_form_inherit_expense_paid" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.expense.paid</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.view_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_pay_linked_expenses"
                        string="Pay Linked Expenses"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': [('hr_expense_ids', '=', [])]}"/>
            </xpath>
        </field>
    </record>
</odoo>