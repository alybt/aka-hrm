<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_negative_net_pay_wizard_form" model="ir.ui.view">
        <field name="name">negative.net.pay.wizard.form</field>
        <field name="model">negative.net.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Negative Net Pay Warning">
                <field name="is_batch" invisible="1"/>
                <field name="batch_id" invisible="1"/>
                <field name="payslip_ids" invisible="1"/>
                
                <div class="alert alert-warning mb-0" role="alert">
                    <field name="message" widget="text" nolabel="1"/>
                </div>

                <footer>
                    <button name="action_confirm" string="Yes, Generate" type="object" class="btn-primary"/>
                    <button string="No, Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
