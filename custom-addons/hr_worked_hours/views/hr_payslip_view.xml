<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_worked_hours" model="ir.ui.view">
        <field name="name">hr.payslip.form.work.hours.breakdown</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Worked Hours Breakdown" name="worked_hours_breakdown">
                    <group>
                        <group>
                            <field name="x_worked_regular_hours"/>
                            <field name="x_worked_regular_holiday_hours"/>
                        </group>
                        <group>
                            <field name="x_worked_specialnw_holiday_hours"/>
                            <field name="x_worked_specialw_holiday_hours"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>