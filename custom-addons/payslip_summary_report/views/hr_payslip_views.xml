<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Button on individual payslip form -->
    <record id="hr_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.batch.actions</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_summary_report"
                        type="object"
                        string="Summary Report"
                        class="btn-secondary"
                        groups="payroll.group_payroll_user"/>
            </xpath>
        </field>
    </record>

    <!-- Button on payslip batch form -->
    <record id="view_payslip_run_form_inherit_summary" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.summary</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_summary_report"
                        type="object"
                        string="Summary Report (Batch)"
                        class="btn-secondary"
                        groups="payroll.group_payroll_user"/>
            </xpath>
        </field>
    </record>
</odoo>