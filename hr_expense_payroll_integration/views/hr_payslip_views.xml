<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Payslip Form View -->
        <record id="hr_payslip_form_inherit_expense" model="ir.ui.view">
            <field name="name">hr.payslip.form.inherit.expense</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="payroll.hr_payslip_form"/>
            <field name="arch" type="xml">
                <!-- Add expense reimbursement information -->
                <xpath expr="//field[@name='worked_days_line_ids']" position="after">
                    <group string="Expense Reimbursements">
                        <field name="total_expense_reimbursement" widget="monetary"/>
                        <field name="expense_reimbursement_ids">
                            <tree editable="false">
                                <field name="name"/>
                                <field name="total_amount" widget="monetary"/>
                                <field name="accounting_date"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Payslip Tree View -->
        <record id="hr_payslip_tree_inherit_expense" model="ir.ui.view">
            <field name="name">hr.payslip.tree.inherit.expense</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="payroll.hr_payslip_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='credit_note']" position="before">
                    <field name="total_expense_reimbursement" widget="monetary" optional="show"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
