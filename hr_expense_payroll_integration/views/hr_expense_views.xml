<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Expense Form View -->
        <record id="hr_expense_form_payroll" model="ir.ui.view">
            <field name="name">hr.expense.form.payroll</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_form_view"/>
            <field name="arch" type="xml">
                <!-- Add payroll fields after payment_mode -->
                <xpath expr="//field[@name='payment_mode']" position="after">
                    <field name="include_in_payroll" 
                           attrs="{'invisible': [('payment_mode', '!=', 'own_account')], 'readonly': [('state', 'not in', ['draft', 'reported'])]}"/>
                    <field name="payroll_paid" attrs="{'invisible': [('include_in_payroll', '=', False)]}"/>
                    <field name="payroll_paid_date" attrs="{'invisible': [('payroll_paid', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <!-- Expense Tree View -->
        <record id="hr_expense_tree_payroll" model="ir.ui.view">
            <field name="name">hr.expense.tree.payroll</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="include_in_payroll" optional="show"/>
                    <field name="payroll_paid" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Expense Search View -->
        <record id="hr_expense_view_search_payroll" model="ir.ui.view">
            <field name="name">hr.expense.search.payroll</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_expenses']" position="after">
                    <separator/>
                    <filter string="Include in Payroll" name="include_in_payroll" domain="[('include_in_payroll', '=', True)]"/>
                    <filter string="Paid via Payroll" name="payroll_paid" domain="[('payroll_paid', '=', True)]"/>
                    <filter string="Pending Payroll Payment" name="pending_payroll" domain="[('include_in_payroll', '=', True), ('payroll_paid', '=', False), ('state', '=', 'approved')]"/>
                </xpath>

                <xpath expr="//group" position="inside">
                    <filter string="Payroll Status" name="group_payroll" context="{'group_by': 'include_in_payroll'}"/>
                </xpath>
            </field>
        </record>

        <!-- Add payroll button to expense form -->
        <record id="hr_expense_form_payroll_button" model="ir.ui.view">
            <field name="name">hr.expense.form.payroll.button</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_mark_payroll_paid" 
                            type="object" 
                            string="Mark as Paid via Payroll"
                            attrs="{'invisible': ['|', ('include_in_payroll', '=', False), ('payroll_paid', '=', True), ('state', '!=', 'approved')]}"
                            class="oe_stat_button"
                            icon="fa-money"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
